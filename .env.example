# Contact form delivery (server-side only — never prefix with NEXT_PUBLIC_).
# Copy to .env.local and fill in to enable sending. Without these the form
# validates but replies "not configured" and shows the direct email instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=pasunuti112004@gmail.com
# Must be a sender on a domain verified in Resend, e.g. "Portfolio <hello@your-domain.com>"
CONTACT_FROM_EMAIL=
